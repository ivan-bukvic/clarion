# Supabase — create project at supabase.com, enable pgvector extension
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Voyage AI embeddings — https://dash.voyageai.com (voyage-3-lite, 512 dim)
VOYAGE_API_KEY=

# Vercel Cron keep-alive secret — prevents Supabase free-plan auto-pause
# (see app/api/cron/keep-alive/route.ts). Set the same value in Vercel
# Project Settings -> Environment Variables; Vercel auto-sends it as
# "Authorization: Bearer <value>" to the cron endpoint. Leave empty locally.
CRON_SECRET=
